# Copy to .env to change settings. Every value is optional: the defaults below
# are what the API uses when a variable is not set.

# --- Server ---
PORT=3000
LOG_LEVEL=info
# Number of reverse proxies in front of the API. Docker Compose sets this to 1 (nginx).
TRUST_PROXY_HOPS=0

# --- Product data source ---
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
# How long product data is cached in memory. 0 turns caching off.
CACHE_TTL_SECONDS=300

# --- Merchandising ---
# The owner's chosen "top rated" products for the home page, in display order.
FEATURED_PRODUCT_IDS=1,5,9,15,18
# How many products the "Top rated" section of a category page shows.
TOP_RATED_PER_CATEGORY=3

# --- Email ---
# Local default is Mailpit (inbox at http://localhost:8025). Docker Compose sets SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_INBOX_EMAIL=sales@example.com
ENQUIRY_FROM_EMAIL=catalogue@example.com

# --- Abuse protection (requests per minute per client IP) ---
API_RATE_LIMIT_PER_MINUTE=120
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
